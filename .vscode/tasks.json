{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "clineModel",
      "type": "promptString",
      "description": "OpenRouter model id for this Cline run",
      "default": "z-ai/glm-5.3"
    },
    {
      "id": "clinePrompt",
      "type": "promptString",
      "description": "Prompt for Cline"
    },
    {
      "id": "claudePrompt",
      "type": "promptString",
      "description": "Prompt for Claude Code"
    },
    {
      "id": "codexPrompt",
      "type": "promptString",
      "description": "Read-only prompt for Codex"
    }
  ],
  "tasks": [
    {
      "label": "Claude Code: prompt",
      "type": "shell",
      "command": "claude",
      "args": [
        "--ide",
        "--permission-mode", "manual",
        "${input:claudePrompt}"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "Cline: OpenRouter prompt",
      "type": "shell",
      "command": "cline",
      "args": [
        "-P", "openrouter",
        "-m", "${input:clineModel}",
        "--thinking", "low",
        "--auto-approve", "false",
        "-c", "${workspaceFolder}",
        "${input:clinePrompt}"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "Codex: read-only prompt",
      "type": "shell",
      "command": "codex",
      "args": [
        "exec",
        "--cd", "${workspaceFolder}",
        "--sandbox", "read-only",
        "${input:codexPrompt}"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    }
  ]
}
